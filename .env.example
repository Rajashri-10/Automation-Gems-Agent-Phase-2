# ==================================================
# CSV CONFIGURATION
# ==================================================

CSV_PATH=data/centeralised demo sheet - centeralised demo sheet.csv


# ==================================================
# GEMINI ENTERPRISE
# ==================================================

# Replace with your actual Gemini Enterprise URL
GEMINI_ENTERPRISE_URL=https://vertexaisearch.cloud.google.com/home/cid/...


# ==================================================
# CHROME / PLAYWRIGHT
# ==================================================

CDP_URL=http://127.0.0.1:9222
HEADLESS=false


# ==================================================
# AUTOMATION
# ==================================================

# Set to true to skip the final "Create" button click for testing
DRY_RUN=false

# 0 = process all agents in the CSV
# X = process only the first X agents
TEST_LIMIT=0

MAX_RETRIES=3
NAVIGATION_TIMEOUT=30000
ACTION_TIMEOUT=15000
DEBUG=true